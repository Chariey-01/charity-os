{
  "id": "/",
  "name": "CharityOS",
  "short_name": "CharityOS",
  "description": "Plan, track and review your days: work, learning, health and life.",
  "start_url": "/#/today",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "background_color": "#f4f3ee",
  "theme_color": "#173f31",
  "categories": ["productivity", "lifestyle", "health"],
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "/icons/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "shortcuts": [
    { "name": "Quick add", "short_name": "Add", "url": "/#/today?add=1", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Schedule", "short_name": "Schedule", "url": "/#/schedule?view=week", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
