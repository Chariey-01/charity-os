// CharityOS on Cloudflare: the PWA plus a same-origin proxy to the Django
// backend (src/worker.js). Runs on the Workers Free plan.
// Deployment steps: docs/operations/cloudflare-deployment.md
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "charityos",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-27",
  // https://charityos.<your-subdomain>.workers.dev; no domain to buy.
  "workers_dev": true,
  // No per-version preview addresses: only the deployed version is reachable.
  "preview_urls": false,
  "build": {
    // Builds frontend/dist before every deploy (and `wrangler dev`).
    "command": "./build.sh"
  },
  "assets": {
    "directory": "../frontend/dist",
    "binding": "ASSETS",
    // The app routes with the URL hash; any other unknown path gets the shell.
    "not_found_handling": "single-page-application",
    // The Worker sees every request: it forwards the API and sets the
    // security and cache headers on the app's files.
    "run_worker_first": true
  },
  "vars": {
    // The backend's own https:// address (not a secret: it refuses requests
    // without EDGE_PROXY_SECRET). Replace before the first deploy.
    "BACKEND_ORIGIN": "https://backend.invalid"
  },
  // EDGE_PROXY_SECRET is a secret: `npx wrangler secret put EDGE_PROXY_SECRET`.
  // For `wrangler dev`, put both values in .dev.vars (git-ignored).
  // Server-side reminders: every minute the Worker checks whether a reminder
  // is due and, only then, asks the backend to send it (src/scheduler.js).
  // Workers Free allows 5 cron triggers per account.
  "triggers": {
    "crons": ["* * * * *"]
  },
  // Optional but recommended: lets the cron skip the backend when nothing is
  // due, so the database can sleep. Create it with
  // `npx wrangler kv namespace create REMINDERS_KV` and paste the id here.
  // "kv_namespaces": [{ "binding": "REMINDERS_KV", "id": "<namespace id>" }],
  // CRON_SECRET is a secret too: `npx wrangler secret put CRON_SECRET`, the
  // same value as the backend's CHARITYOS_CRON_SECRET.
  "observability": {
    "enabled": true
  }
}
