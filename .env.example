# Django
DJANGO_SECRET_KEY=replace-with-a-random-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173

# PostgreSQL
POSTGRES_DB=charityos
POSTGRES_USER=charityos
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Reverse proxy (production only). Leave empty unless a proxy you run sits in
# front of Django; then list its address(es). See docs/operations/reverse-proxy.md.
CHARITYOS_TRUSTED_PROXIES=

# Production only (see docs/operations/production-runbook.md). On Render these
# come from the service's environment, never from a file:
#   DJANGO_SETTINGS_MODULE=config.settings.production
#   DATABASE_URL=postgresql://user:password@host:5432/charityos  (instead of POSTGRES_*, never both)
#   CHARITYOS_APPROVE_MIGRATIONS=<code printed by manage.py predeploy>  (only while approving)
# Behind Cloudflare (docs/operations/cloudflare-deployment.md) also:
#   CHARITYOS_FRONTEND=external
#   CHARITYOS_EDGE_PROXY_SECRET=<48+ random characters, same value as the Worker's EDGE_PROXY_SECRET>
#   DJANGO_CSRF_TRUSTED_ORIGINS=https://charityos.<subdomain>.workers.dev
